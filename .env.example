# Server configuration. Do not commit a real .env file.
# In production, set NODE_ENV=production and use a persistent absolute database path.
PORT=3001
DATABASE_PATH=./data/saarthi.db
# Use a unique, high-entropy value in production.
SESSION_SECRET=replace-this-demo-secret
SESSION_DAYS=14
# Optional: guided application uses its deterministic fallback when no key is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional only for local API-compatible test servers; omit in production.
OPENAI_BASE_URL=
